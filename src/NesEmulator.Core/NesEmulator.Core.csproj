<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NesEmulator.Core</RootNamespace>
    <AssemblyName>NesEmulator.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>1.2.0</Version>
    <Product>NES Emulator</Product>
    <Company>szabolevi98</Company>
    <Copyright>Copyright (c) 2026 szabolevi98</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!--
      This project is a real-time simulation: it has to finish 29,781 processor
      cycles and 733 filtered audio samples inside every 16.6 ms frame. Built
      without optimisation it manages about half that, which starves the sound
      card and makes a debug run sound broken rather than slow. Optimising it in
      every configuration keeps Start Debugging usable; the app and test projects
      are still built unoptimised, so breakpoints there behave normally.
    -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NesEmulator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- StateIo extends BinaryReader for every component that saves state. -->
    <Using Include="NesEmulator.Core" />
  </ItemGroup>

</Project>
